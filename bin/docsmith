#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use Docsmith\Docsmith;

const USAGE = <<<TXT
Usage:
  php bin/docsmith build [options]
  php bin/docsmith --help

Options:
  --source=DIR          Directory with markdown sources (required)
  --output=DIR          Output directory (default: docs)
  --title=TITLE         Site title (default: Documentation)
  --description=DESC    Site description
  --accent-color=HEX    Accent color (default: #ff2d20)
  --accent-color-dark=HEX  Dark-mode accent color
  --custom-css=FILE     Path to custom CSS file
  --base-url=URL        Base URL (default: /)
  --right-sidebar       Enable the right sidebar
  --repository-url=URL  Repository URL for edit links
  --site-url=URL        Canonical site URL
  --edit-branch=BRANCH  Branch used for edit links (default: main)
  --favicon=FILE        Custom favicon URL, data URI, or file path
  --og-type=TYPE        Open Graph image type: generated or link
  --og-scope=SCOPE      Open Graph image scope: all or per-page
  --og-url=URL          Open Graph image URL/path (required for --og-type=link)
  --og-template=FILE    Custom Open Graph card template path or raw HTML
  --no-og-capture       Write OG previews/config only; skip screenshot capture
  --force-og            Recapture every Open Graph image (ignore cache)

Example:
  php bin/docsmith build --source=md --output=docs --title="My Docs" --site-url=https://example.com
  php bin/docsmith build --source=md --favicon=favicon.svg --og-type=generated --og-scope=all
TXT;

$options = parseArgs($argv);

if (isset($options['help'])) {
    echo USAGE;

    exit(0);
}

$source = $options['source'] ?? null;

if (! is_string($source) || $source === '') {
    fwrite(STDERR, "Missing required option: --source\n\n" . USAGE);

    exit(1);
}

if (! is_dir($source)) {
    fwrite(STDERR, "Source directory does not exist: {$source}\n");

    exit(1);
}

$builder = Docsmith::make()
    ->source($source)
    ->output(stringOption($options, 'output', 'docs'))
    ->title(stringOption($options, 'title', 'Documentation'))
    ->description(stringOption($options, 'description', 'Project documentation.'))
    ->accentColor(stringOption($options, 'accent-color', '#ff2d20'))
    ->accentColorDark(stringOption($options, 'accent-color-dark', ''))
    ->customCss(stringOption($options, 'custom-css', ''))
    ->baseUrl(stringOption($options, 'base-url', '/'))
    ->rightSidebar(boolOption($options, 'right-sidebar'))
    ->repositoryUrl(stringOption($options, 'repository-url', ''))
    ->siteUrl(stringOption($options, 'site-url', ''))
    ->editBranch(stringOption($options, 'edit-branch', 'main'));

$favicon = stringOption($options, 'favicon', '');

if ($favicon !== '') {
    $builder->favicon($favicon);
}

$ogType = stringOption($options, 'og-type', '');

if ($ogType !== '') {
    $builder->ogImage(
        type: $ogType,
        scope: stringOption($options, 'og-scope', 'all'),
        url: stringOption($options, 'og-url', ''),
        template: stringOption($options, 'og-template', ''),
    );
}

if (boolOption($options, 'no-og-capture')) {
    $builder->captureOg(false);
}

if (boolOption($options, 'force-og')) {
    $builder->forceOg();
}

$builder->build();

echo "Built docs from {$source} to " . stringOption($options, 'output', 'docs') . "\n";

/**
 * @param  array<int, string>  $argv
 * @return array<string, string|bool>
 */
function parseArgs(array $argv): array
{
    $options = [];

    foreach (array_slice($argv, 1) as $arg) {
        if (! str_starts_with($arg, '--')) {
            continue;
        }

        $pair = explode('=', substr($arg, 2), 2);

        if (count($pair) === 2) {
            $options[$pair[0]] = $pair[1];
        } else {
            $options[$pair[0]] = true;
        }
    }

    return $options;
}

function stringOption(array $options, string $key, string $default): string
{
    return is_string($options[$key] ?? null) && $options[$key] !== '' ? $options[$key] : $default;
}

function boolOption(array $options, string $key): bool
{
    $value = $options[$key] ?? false;

    return $value === true || $value === '1' || $value === 'true';
}
