#!/usr/bin/env php
<?php

declare(strict_types=1);

use Docsmith\Command\InstallAiCommand;
use Docsmith\Command\McpServeCommand;
use Symfony\Component\Console\Application;

$autoloader = null;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $file) {
    if (is_file($file)) {
        $autoloader = $file;

        break;
    }
}

if ($autoloader === null) {
    fwrite(STDERR, "[Docsmith] Unable to find the Composer autoloader. Run `composer install` first.\n");

    exit(1);
}

require $autoloader;

use Docsmith\Docsmith;
use Docsmith\RemoteSources\RemoteSources;
use Docsmith\RemoteSources\InvalidSourcesConfiguration;
use League\CommonMark\Extension\ExtensionInterface;

if (class_exists(McpServeCommand::class) && in_array($argv[1] ?? null, ['mcp:serve', 'install:ai'], true)) {
    $application = new Application('Docsmith');
    $application->addCommands([new McpServeCommand(), new InstallAiCommand()]);

    exit($application->run());
}

const USAGE = <<<TXT
Usage:
  php bin/docsmith build [options]
  php bin/docsmith sync [options]
  php bin/docsmith mcp:serve [options]  (MCP server for coding agents)
  php bin/docsmith install:ai [options] (MCP config, guidelines, and skills for AI agents)
  php bin/docsmith --help

Build options:
  --source=DIR          Directory with markdown sources (required)
  --output=DIR          Output directory (default: docs)
  --title=TITLE         Site title (default: Documentation)
  --description=DESC    Site description
  --accent-color=HEX    Accent color (default: #ff2d20)
  --accent-color-dark=HEX  Dark-mode accent color
  --custom-css=FILE     Path to custom CSS file
  --commonmark-config=FILE
                        PHP file returning CommonMark extensions and config
  --base-url=URL        Base URL (default: /)
  --right-sidebar       Enable the right sidebar
  --repository-url=URL  Repository URL for edit links
  --site-url=URL        Canonical site URL
  --edit-branch=BRANCH  Branch used for edit links (default: main)
  --edit-prefix=PREFIX  Path prefix prepended to file path in edit links (e.g. md/)
  --favicon=FILE        Custom favicon URL, data URI, or file path
  --no-docsmith-badge   Hide the "Built with DocSmith" sidebar badge
  --og-type=TYPE        Open Graph image type: generated or link
  --og-scope=SCOPE      Open Graph image scope: all or per-page
  --og-url=URL          Open Graph image URL/path (required for --og-type=link)
  --og-template=FILE    Custom Open Graph card template path or raw HTML
  --no-og-capture       Write OG previews/config only; skip screenshot capture
  --force-og            Recapture every Open Graph image (ignore cache)

Remote Sources:
  sync                  Fetch remote documentation sources and materialize
                        them under the markdown root, then exit.
  build --sync          Synchronize remote sources before building.
  --sources=FILE        Sources manifest path (default: ./docsmith.sources.php)
  --force               Re-download even when the remote revision is unchanged.
  --verify              Verify materialized files against recorded hashes.
  --md=DIR              Markdown root for materialized targets (default: md)

Remote sources never change how `build` behaves when no docsmith.sources.php
is present; builds stay deterministic and work fully offline.

Examples:
  php bin/docsmith build --source=md --output=docs --title="My Docs"
  php bin/docsmith sync
  php bin/docsmith build --source=md --sync --output=docs
TXT;

$argv = array_values($GLOBALS['argv'] ?? []);
$command = $argv[1] ?? null;

if ($command === 'build' || $command === 'sync') {
    array_splice($argv, 1, 1);
} else {
    // Legacy invocation style without a subcommand behaves like `build`.
    $command = 'build';
}

$options = parseArgs($argv);

if (isset($options['help'])) {
    echo USAGE;

    exit(0);
}

$markdownRoot = stringOption($options, 'md', 'md');

// --------------------------------------------------------------------- sync

if ($command === 'sync' || isset($options['sync'])) {
    $exitCode = runSync($options, $command === 'sync', $markdownRoot);

    if ($exitCode !== 0) {
        exit($exitCode);
    }

    if ($command === 'sync') {
        echo 'Sync complete.' . PHP_EOL;

        exit(0);
    }
}

// -------------------------------------------------------------------- build

$source = $options['source'] ?? null;

if (! is_string($source) || $source === '') {
    fwrite(STDERR, "Missing required option: --source\n\n" . USAGE);

    exit(1);
}

if (! is_dir($source)) {
    fwrite(STDERR, "Source directory does not exist: {$source}\n");

    exit(1);
}

$builder = Docsmith::make()
    ->source($source)
    ->output(stringOption($options, 'output', 'docs'))
    ->title(stringOption($options, 'title', 'Documentation'))
    ->description(stringOption($options, 'description', 'Documentation.'))
    ->accentColor(stringOption($options, 'accent-color', '#ff2d20'))
    ->accentColorDark(stringOption($options, 'accent-color-dark', ''))
    ->customCss(stringOption($options, 'custom-css', ''))
    ->baseUrl(stringOption($options, 'base-url', '/'))
    ->rightSidebar(boolOption($options, 'right-sidebar'))
    ->repositoryUrl(stringOption($options, 'repository-url', ''))
    ->siteUrl(stringOption($options, 'site-url', ''))
    ->editBranch(stringOption($options, 'edit-branch', 'main'))
    ->editPrefix(stringOption($options, 'edit-prefix', ''))
    ->showDocsmithBadge(! boolOption($options, 'no-docsmith-badge'));

$commonMarkConfigPath = stringOption($options, 'commonmark-config', '');

if ($commonMarkConfigPath !== '') {
    try {
        $commonMark = loadCommonMarkConfig($commonMarkConfigPath);
        $builder
            ->commonMarkExtensions($commonMark['extensions'])
            ->commonMarkConfig($commonMark['config']);
    } catch (Throwable $error) {
        fwrite(STDERR, '[Docsmith] Invalid CommonMark config: ' . $error->getMessage() . "\n");

        exit(1);
    }
}

$favicon = stringOption($options, 'favicon', '');

if ($favicon !== '') {
    $builder->favicon($favicon);
}

$ogType = stringOption($options, 'og-type', '');

if ($ogType !== '') {
    $builder->ogImage(
        type: $ogType,
        scope: stringOption($options, 'og-scope', 'all'),
        url: stringOption($options, 'og-url', ''),
        template: stringOption($options, 'og-template', ''),
    );
}

if (boolOption($options, 'no-og-capture')) {
    $builder->captureOg(false);
}

if (boolOption($options, 'force-og')) {
    $builder->forceOg();
}

$builder->build();

echo "Built docs from {$source} to " . stringOption($options, 'output', 'docs') . "\n";

/**
 * @param  array<string, string|bool>  $options
 */
function runSync(array $options, bool $required, string $markdownRoot): int
{
    $sourcesPath = stringOption($options, 'sources', getcwd() . '/' . \Docsmith\RemoteSources\SourcesManifest::FILE_NAME);

    if (! is_file($sourcesPath)) {
        if ($required) {
            fwrite(STDERR, "No sources manifest found at {$sourcesPath}.\nCreate one to pull documentation from other Git repositories.\n");

            return 1;
        }

        return 0; // `--sync` requested but nothing configured: keep builds unchanged.
    }

    try {
        $report = \Docsmith\RemoteSources\RemoteSources::sync(
            $sourcesPath,
            markdownRoot: $markdownRoot,
            force: boolOption($options, 'force'),
            verify: boolOption($options, 'verify'),
        );
    } catch (InvalidSourcesConfiguration $error) {
        fwrite(STDERR, '[Docsmith] ' . $error->getMessage() . "\n");

        return 1;
    } catch (\Throwable $error) {
        fwrite(STDERR, '[Docsmith] Sync failed: ' . $error->getMessage() . "\n");

        return 1;
    }

    foreach ($report->entries() as $entry) {
        foreach ($entry['warnings'] as $warning) {
            echo '[Docsmith] warning: ' . $warning . PHP_EOL;
        }
    }

    echo '[Docsmith] Sources: ' . $report->summary() . PHP_EOL;

    return $report->isSuccessful() ? 0 : 1;
}

/**
 * @param  array<int, string>  $argv
 * @return array<string, string|bool>
 */
function parseArgs(array $argv): array
{
    $options = [];

    foreach (array_slice($argv, 1) as $arg) {
        if (! str_starts_with($arg, '--')) {
            continue;
        }

        $pair = explode('=', substr($arg, 2), 2);

        if (count($pair) === 2) {
            $options[$pair[0]] = $pair[1];
        } else {
            $options[$pair[0]] = true;
        }
    }

    return $options;
}

function stringOption(array $options, string $key, string $default): string
{
    return is_string($options[$key] ?? null) && $options[$key] !== '' ? $options[$key] : $default;
}

function boolOption(array $options, string $key): bool
{
    $value = $options[$key] ?? false;

    return $value === true || $value === '1' || $value === 'true';
}

/**
 * Load a CLI CommonMark config file. Extension and config values are
 * validated by the builder when applied.
 *
 * @return array{extensions: list<ExtensionInterface>, config: array<string, mixed>}
 */
function loadCommonMarkConfig(string $path): array
{
    if (! is_file($path)) {
        throw new InvalidArgumentException("File does not exist: {$path}");
    }

    $manifest = require $path;

    if (! is_array($manifest)) {
        throw new InvalidArgumentException('The file must return an array.');
    }

    $extensions = $manifest['extensions'] ?? [];
    $config = $manifest['config'] ?? [];

    if (! is_array($extensions) || ! array_is_list($extensions)) {
        throw new InvalidArgumentException('[extensions] must be a list of CommonMark extensions.');
    }

    if (! is_array($config)) {
        throw new InvalidArgumentException('[config] must be an array.');
    }

    return [
        'extensions' => $extensions,
        'config' => $config,
    ];
}
